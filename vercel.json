{
  "version": 2,
  "buildCommand": "bash build.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,api/static/**,dataset/working/**,dataset/test.csv,dataset/sample_submission.csv,tests/**,docs/**,*.ipynb,*.md,scratch/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=$1"
    },
    {
      "source": "/((?!assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
